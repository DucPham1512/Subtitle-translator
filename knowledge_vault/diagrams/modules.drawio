line, review, settings, translation, workspace&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="110" y="180" width="900" height="78" as="geometry"/></mxCell><mxCell id="layer9" value="L9" style="text;html=1;fontSize=12;fontStyle=1;align=center;" parent="1" vertex="1"><mxGeometry x="40" y="294" width="40" height="30" as="geometry"/></mxCell><mxCell id="m_pipeline" value="&lt;b&gt;pipeline&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;stages.py (stage table, run_stage) · runner.py (Runner with resume, Pipeline) · report.py&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;uses: cast, infra, kernel, llm, memory, ocr, output, review, settings, translation, voice, workspace&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="110" y="270" width="900" height="78" as="geometry"/></mxCell><mxCell id="layer8" value="L8" style="text;html=1;fontSize=12;fontStyle=1;align=center;" parent="1" vertex="1"><mxGeometry x="40" y="384" width="40" height="30" as="geometry"/></mxCell><mxCell id="m_output" value="&lt;b&gt;output&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;render.py (ASS + mask + burn-in, 5.19) · delivery.py (output folder, cleanup, 5.22-5.23)&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;uses: infra, kernel, settings, workspace&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="110" y="360" width="900" height="78" as="geometry"/></mxCell><mxCell id="layer7" value="L7" style="text;html=1;fontSize=12;fontStyle=1;align=center;" parent="1" vertex="1"><mxGeometry x="40" y="474" width="40" height="30" as="geometry"/></mxCell><mxCell id="m_bootstrap" value="&lt;b&gt;bootstrap&lt;/b