<mxGraphModel dx="765" dy="731" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1320" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Who speaks, who listens: how evidence reaches the LLM" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="20" y="5" width="2380" height="40" as="geometry"/></mxCell><mxCell id="pan0" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#dddddd;" parent="1" vertex="1"><mxGeometry x="30" y="50" width="340" height="1120" as="geometry"/></mxCell><mxCell id="hdr0" value="(1) Evidence sources" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="30" y="50" width="340" height="35" as="geometry"/></mxCell><mxCell id="pan1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#dddddd;" parent="1" vertex="1"><mxGeometry x="430" y="50" width="340" height="1120" as="geometry"/></mxCell><mxCell id="hdr1" value="(2) Gates in code" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="430" y="50" width="340" height="35" as="geometry"/></mxCell><mxCell id="pan2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#dddddd;" parent="1" vertex="1"><mxGeometry x="810" y="50" width="400" height="1120" as="geometry"/></mxCell><mxCell id="hdr2" value="(3) What the translator LLM sees" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="810" y="50" width="400" height="35" as="geometry"/></mxCell><mxCell id="pan3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#dddddd;" parent="1" vertex="1"><mxGeometry x="1250" y="50" width="730" height="1120" as="geometry"/></mxCell><mxCell id="hdr3" value="(4) How the LLM decides" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1250" y="50" width="730" height="35" as="geometry"/></mxCell><mxCell id="pan4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#dddddd;" parent="1" vertex="1"><mxGeometry x="2010" y="50" width="380" height="1120" as="geometry"/></mxCell><mxCell id="hdr4" value="(5) Checks and final result" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="2010" y="50" width="380" height="35" as="geometry"/></mxCell><mxCell id="c_mem" value="&lt;b&gt;C. CONTEXT: Memory prefix&lt;/b&gt;&lt;br&gt;characters (archived left out, generic marked), pronoun matrix, story so far, style rules, new voices of this episode with line counts and first time, known characters without a voice sample, recent reviewer corrections" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;spacingRight=6;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1"><mxGeometry x="45" y="110" width="310" height="180" as="geometry"/></mxCell><mxCell id="a_voice" value="&lt;b&gt;A. VOICE&lt;/b&gt;&lt;br&gt;Voice match per line → speaker_status + top-3 speaker_candidates with scores&lt;br&gt;(fixed / confusable / new_voice / unknown / too_short)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1"><mxGeometry x="45" y="330" width="310" height="100" as="geometry"/></mxCell><mxCell id="b_pic" value="&lt;b&gt;B. PICTURE&lt;/b&gt;&lt;br&gt;Cast stage per line → on_screen (recognised ids), unrecognised_on_screen (count), talking (id or 'unrecognised')" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;spacingRight=6;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1"><mxGeometry x="45" y="470" width="310" height="100" as="geometry"/></mxCell><mxCell id="c_scene" value="&lt;b&gt;C. CONTEXT: Scene window&lt;/b&gt;&lt;br&gt;the lines in order (Chinese) + 5 earlier lines with their chosen speaker, listener and Vietnamese" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;spacingRight=6;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1"><mxGeometry x="45" y="900" width="310" height="100" as="geometry"/></mxCell><mxCell id="c_cues" value="&lt;b&gt;C. CONTEXT: Dialogue cues inside the text&lt;/b&gt;&lt;br&gt;names, forms of address (师兄, 掌柜, 爸爸), question and answer turns" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;spacingRight=6;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1"><mxGeometry x="45" y="1030" width="310" height="90" as="geometry"/></mxCell><mxCell id="gates" value="Gates applied to the picture fields" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;fontSize=11;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="440" y="420" width="320" height="410" as="geometry"/></mxCell><mxCell id="g1" value="&lt;b&gt;Gate 1: picture_evidence = tiebreak&lt;/b&gt; (current setting)&lt;br&gt;picture fields are REMOVED from lines whose voice status is fixed or new_voice; shown only on confusable / unknown / too_short lines&lt;br&gt;&lt;i&gt;(other settings: all = always, off = never)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;spacingRight=6;fillColor=#eeeeee;strokeColor=#666666;" parent="1" vertex="1"><mxGeometry x="455" y="460" width="290" height="150" as="geometry"/></mxCell><mxCell id="g2" value="&lt;b&gt;Gate 2 (picture_veto: OFF today)&lt;/b&gt;&lt;br&gt;If the talking sprite is a recognised character other than the voice's choice → status becomes DISPUTED and the talker is added to the candidates" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;spacingRight=6;fillColor=#eeeeee;strokeColor=#666666;dashed=1;" parent="1" vertex="1"><mxGeometry x="455" y="650" width="290" height="120" as="geometry"/></mxCell><mxCell id="g2n" value="measured: did not improve accuracy, so it is off" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fffbe6;strokeColor=#b3a14d;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="470" y="780" width="260" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Translator input" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;fontSize=11;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="820" y="100" width="380" height="1040" as="geometry"/></mxCell><mxCell id="pref" value="&lt;b&gt;Memory prefix&lt;/b&gt; (same bytes for every call of the episode)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;spacingRight=6;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1"><mxGeometry x="840" y="140" width="340" height="120" as="geometry"/></mxCell><mxCell id="req" value="&lt;b&gt;One request per scene window&lt;/b&gt;&lt;br&gt;&lt;br&gt;per line:&lt;br&gt;• event_id&lt;br&gt;• zh&lt;br&gt;• duration&lt;br&gt;• max_vi_chars&lt;br&gt;• speaker_status&lt;br&gt;• speaker_candidates&lt;br&gt;• [on_screen, unrecognised_on_screen, talking]&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;only when allowed by Gate 1&lt;/i&gt;&lt;br&gt;• non_dialogue_suspect" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#f3ecf7;strokeColor=#9673a6;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="840" y="300" width="340" height="580" as="geometry"/></mxCell><mxCell id="prev" value="&lt;b&gt;Previous context lines&lt;/b&gt;&lt;br&gt;(5 earlier lines: zh, speaker, listener, vi)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;spacingRight=6;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1"><mxGeometry x="840" y="920" width="340" height="100" as="geometry"/></mxCell><mxCell id="cuesin" value="dialogue cues travel inside the zh text" style="text;html=1;fontSize=10;fontStyle=2;align=center;verticalAlign=middle;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="840" y="1050" width="340" height="50" as="geometry"/></mxCell><mxCell id="tbl" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="1270" y="300" width="440" height="510" as="geometry"/></mxCell><mxCell id="th" value="&lt;b&gt;Speaker decision by status&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#9673a6;strokeColor=#9673a6;fontColor=#ffffff;fontSize=11;" parent="1" vertex="1"><mxGeometry x="1270" y="300" width="440" height="36" as="geometry"/></mxCell><mxCell id="rs0" value="&lt;b&gt;fixed&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1270" y="336" width="140" height="78" as="geometry"/></mxCell><mxCell id="rr0" value="Keep voice candidate #1; change only if the DIALOGUE makes it impossible, and explain in notes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="1410" y="336" width="300" height="78" as="geometry"/></mxCell><mxCell id="rs1" value="&lt;b&gt;new_voice&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1270" y="414" width="140" height="78" as="geometry"/></mxCell><mxCell id="rr1" value="Keep the npc id; change only if the dialogue shows it is a known character (e.g. one without a voice sample)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="1410" y="414" width="300" height="78" as="geometry"/></mxCell><mxCell id="rs2" value="&lt;b&gt;confusable&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1270" y="492" width="140" height="78" as="geometry"/></mxCell><mxCell id="rr2" value="Choose ONLY among the candidates; dialogue first, talking sprite as a tie-breaker" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="1410" y="492" width="300" height="78" as="geometry"/></mxCell><mxCell id="rs3" value="&lt;b&gt;disputed&lt;br&gt;&lt;i&gt;(veto on)&lt;/i&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;dashed=1;" parent="1" vertex="1"><mxGeometry x="1270" y="570" width="140" height="78" as="geometry"/></mxCell><mxCell id="rr3" value="Choose among the candidates by the dialogue, or null; do not follow the voice by default" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=6;dashed=1;" parent="1" vertex="1"><mxGeometry x="1410" y="570" width="300" height="78" as="geometry"/></mxCell><mxCell id="rs4" value="&lt;b&gt;unknown /&lt;br&gt;too_short&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1270" y="648" width="140" height="84" as="geometry"/></mxCell><mxCell id="rr4" value="Pick a character present in the scene only when the dialogue makes it clear (talking may support a clear dialogue clue); otherwise null. Never guess" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="1410" y="648" width="300" height="84" as="geometry"/></mxCell><mxCell id="rs5" value="&lt;b&gt;non_dialogue_suspect&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1270" y="732" width="140" height="78" as="geometry"/></mxCell><mxCell id="rr5" value="If it is a sign/title/sfx: line_type set, speaker and listener null" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="1410" y="732" width="300" height="78" as="geometry"/></mxCell><mxCell id="lis" value="&lt;b&gt;LISTENER&lt;/b&gt;&lt;br&gt;No voice or picture input. Decided from context only: who is addressed (name/title in the line, who answers next, previous speaker); null for a group, self-talk or unclear" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;spacingRight=6;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1"><mxGeometry x="1270" y="860" width="440" height="100" as="geometry"/></mxCell><mxCell id="pron" value="&lt;b&gt;Pronoun choice&lt;/b&gt;: pronoun matrix row (speaker, listener) → self term / address term" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;spacingRight=6;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1"><mxGeometry x="1270" y="1000" width="440" height="55" as="geometry"/></mxCell><mxCell id="evs" value="&lt;b&gt;Evidence strength&lt;/b&gt;: dialogue &amp;gt; voice &amp;gt; picture&lt;br&gt;(picture never decides alone)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1"><mxGeometry x="1270" y="1090" width="440" height="55" as="geometry"/></mxCell><mxCell id="out" value="&lt;b&gt;LLM output per line&lt;/b&gt;&lt;br&gt;speaker, listener, speaker_conf (honest; &amp;lt; 0.6 when guessing), notes" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;spacingRight=6;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="1760" y="560" width="210" height="100" as="geometry"/></mxCell><mxCell id="rules" value="&lt;b&gt;Rule checks (code)&lt;/b&gt;&lt;br&gt;ids must be known characters or this episode's new voices; confusable speaker must be a candidate; disputed speaker a candidate or null; pronoun terms must fit the matrix for the pair; a fixed/new_voice speaker that differs from the voice = warning" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;spacingRight=6;fillColor=#eeeeee;strokeColor=#666666;" parent="1" vertex="1"><mxGeometry x="2030" y="300" width="340" height="170" as="geometry"/></mxCell><mxCell id="eval" value="&lt;b&gt;Evaluator (Gemini) 'speaker' score 1-5&lt;/b&gt;&lt;br&gt;plausibility given scene and voice candidates; at most 2 when a sure voice was overridden without a dialogue reason" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;spacingRight=6;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1"><mxGeometry x="2030" y="530" width="340" height="120" as="geometry"/></mxCell><mxCell id="flags" value="&lt;b&gt;Final flags&lt;/b&gt;&lt;br&gt;speaker_override (changed a fixed voice), low_speaker_conf (&amp;lt; 0.6)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;spacingRight=6;fillColor=#eeeeee;strokeColor=#666666;" parent="1" vertex="1"><mxGeometry x="2030" y="710" width="340" height="70" as="geometry"/></mxCell><mxCell id="draft" value="Review draft" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;spacingRight=6;fillColor=#eeeeee;strokeColor=#666666;align=center;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="2030" y="830" width="340" height="50" as="geometry"/></mxCell><mxCell id="human" value="&lt;b&gt;Human reviewer&lt;/b&gt;&lt;br&gt;confirms or corrects speaker / listener" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="2030" y="930" width="340" height="70" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Measured on the 16-episode replay&lt;/b&gt;&lt;br&gt;speaker right 81.6% (known characters 94.8%, new characters 55.6%)&lt;br&gt;listener 95.8%&lt;br&gt;voice first candidate right 97.2% when 'fixed', 68.6% when 'confusable'" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fffbe6;strokeColor=#b3a14d;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="2470" y="100" width="300" height="130" as="geometry"/></mxCell><mxCell id="lg" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;fontSize=11;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="2470" y="260" width="300" height="330" as="geometry"/></mxCell><mxCell id="lgs0" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1"><mxGeometry x="2485" y="295" width="50" height="24" as="geometry"/></mxCell><mxCell id="lgt0" value="Voice evidence" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="2545" y="295" width="210" height="24" as="geometry"/></mxCell><mxCell id="lgs1" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;spacingRight=6;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1"><mxGeometry x="2485" y="329" width="50" height="24" as="geometry"/></mxCell><mxCell id="lgt1" value="Picture evidence" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="2545" y="329" width="210" height="24" as="geometry"/></mxCell><mxCell id="lgs2" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacin