<mxGraphModel dx="2822" dy="731" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="2460" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Translation pipeline: translator and evaluator loop" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="20" y="5" width="1880" height="35" as="geometry"/></mxCell><mxCell id="inp" value="Inputs (per episode, read by the Pipeline)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=11;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="20" y="50" width="1880" height="170" as="geometry"/></mxCell><mxCell id="i_mem" value="&lt;b&gt;Memory&lt;/b&gt;&lt;br&gt;characters, glossary, pronoun matrix, story so far, style rules, reviewer corrections" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.15;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" parent="1" vertex="1"><mxGeometry x="50" y="90" width="400" height="110" as="geometry"/></mxCell><mxCell id="i_ev" value="&lt;b&gt;events.jsonl&lt;/b&gt;&lt;br&gt;Chinese lines + times" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.15;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" parent="1" vertex="1"><mxGeometry x="480" y="90" width="310" height="110" as="geometry"/></mxCell><mxCell id="i_sp" value="&lt;b&gt;speakers.jsonl&lt;/b&gt;&lt;br&gt;voice match" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.15;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" parent="1" vertex="1"><mxGeometry x="820" y="90" width="310" height="110" as="geometry"/></mxCell><mxCell id="i_ca" value="&lt;b&gt;cast.jsonl&lt;/b&gt;&lt;br&gt;who is on screen / talking" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.15;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1160" y="90" width="310" height="110" as="geometry"/></mxCell><mxCell id="i_wi" value="&lt;b&gt;windows.json&lt;/b&gt;&lt;br&gt;scenes" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.15;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1500" y="90" width="310" height="110" as="geometry"/></mxCell><mxCell id="L1" value="Pipeline (Python code)" style="swimlane;startSize=40;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;swimlaneFillColor=#ffffff;fillColor=#e8f3e6;" parent="1" vertex="1"><mxGeometry x="20" y="240" width="820" height="2200" as="geometry"/></mxCell><mxCell id="L2" value="Translator LLM: DeepSeek deepseek-chat" style="swimlane;startSize=40;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;swimlaneFillColor=#ffffff;fillColor=#e3edf9;" parent="1" vertex="1"><mxGeometry x="840" y="240" width="300" height="2200" as="geometry"/></mxCell><mxCell id="L3" value="Rule checks (Python, free)" style="swimlane;startSize=40;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;swimlaneFillColor=#ffffff;fillColor=#e8f3e6;" parent="1" vertex="1"><mxGeometry x="1140" y="240" width="380" height="2200" as="geometry"/></mxCell><mxCell id="L4" value="Evaluator LLM: Gemini flash-lite&lt;br&gt;(different model family on purpose)" style="swimlane;startSize=40;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;swimlaneFillColor=#ffffff;fillColor=#e3edf9;" parent="1" vertex="1"><mxGeometry x="1520" y="240" width="380" height="2200" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="405" y="300" width="30" height="30" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;1.&lt;/b&gt; Build memory prefix ONCE per episode&lt;br&gt;(byte-identical for every call, so the provider's prompt cache hits)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1"><mxGeometry x="280" y="360" width="280" height="80" as="geometry"/></mxCell><mxCell id="n_prompt" value="prompt = static system prompt + memory prefix + variable part" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fffbe6;strokeColor=#b3a14d;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="60" y="360" width="180" height="80" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;2. LOOP: for each scene window&lt;/b&gt;&lt;br&gt;split at gaps &amp;gt; 3 s or 40 lines; carries 5 earlier lines as read-only context" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=10;" parent="1" vertex="1"><mxGeometry x="280" y="490" width="280" height="80" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;3.&lt;/b&gt; Build the request:&lt;br&gt;previous context lines (zh, speaker, listener, vi) + lines to translate (zh, duration, max characters, speaker_status, speaker_candidates, picture fields when allowed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1"><mxGeometry x="280" y="620" width="280" height="100" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;4. Translate the window&lt;/b&gt;&lt;br&gt;per line returns speaker, listener, speaker_conf, line_type, vi, notes, memory proposals&lt;br&gt;(JSON, validated with Pydantic)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="1" vertex="1"><mxGeometry x="860" y="610" width="260" height="130" as="geometry"/></mxCell><mxCell id="n_llm" value="Every LLM call: disk cache (rerun costs $0) + cost.jsonl record + budget check" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fffbe6;strokeColor=#b3a14d;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="860" y="300" width="260" height="80" as="geometry"/></mxCell><mxCell id="d5" value="5. Line returned?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="330" y="800" width="180" height="90" as="geometry"/></mxCell><mxCell id="miss" value="Mark failed: missing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1"><mxGeometry x="600" y="820" width="200" height="50" as="geometry"/></mxCell><mxCell id="d6" value="6. Same answer as an earlier attempt?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="320" y="950" width="200" height="100" as="geometry"/></mxCell><mxCell id="reuse" value="Reuse that verdict, stop retrying this line" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1"><mxGeometry x="60" y="970" width="180" height="60" as="geometry"/></mxCell><mxCell id="n_soft" value="Reading speed is a SOFT failure: flagged cps_exceeded, never retried" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fffbe6;strokeColor=#b3a14d;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="1180" y="800" width="300" height="70" as="geometry"/></mxCell><mxCell id="s7" value="&lt;b&gt;7. Check each line&lt;/b&gt;&lt;br&gt;length &amp;lt;= 42, at most 2 lines, glossary terms used, speaker/listener are known ids, confusable/disputed speaker is a candidate, pronoun terms match the matrix, reading speed &amp;lt;= 17 cps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1170" y="930" width="320" height="160" as="geometry"/></mxCell><mxCell id="d7" value="Hard failure?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1240" y="1140" width="180" height="100" as="geometry"/></mxCell><mxCell id="skip" value="Skip the LLM rubric for this line" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1200" y="1285" width="260" height="60" as="geometry"/></mxCell><mxCell id="n_eval" value="The evaluator never edits: it scores and suggests; the translator rewrites" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fffbe6;strokeColor=#b3a14d;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="1550" y="940" width="320" height="70" as="geometry"/></mxCell><mxCell id="s8" value="&lt;b&gt;8. Score each remaining line 1-5&lt;/b&gt;&lt;br&gt;meaning, pronouns, register, naturalness, speaker (sees the whole scene, voice candidates, translator notes); gives feedback + a corrected suggestion when it fails.&lt;br&gt;&lt;i&gt;One batched call per attempt.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1550" y="1120" width="320" height="160" as="geometry"/></mxCell><mxCell id="judge" value="&lt;b&gt;9. Judge&lt;/b&gt;&lt;br&gt;PASSED = no hard rule failure AND every score &amp;gt;= 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1"><mxGeometry x="280" y="1290" width="280" height="100" as="geometry"/></mxCell><mxCell id="d10" value="10. Any failed lines AND attempts &amp;lt; 3?&lt;br&gt;(1 + max_retries 2)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="290" y="1460" width="260" height="120" as="geometry"/></mxCell><mxCell id="resend" value="Resend ONLY the failed lines with earlier_attempts (each try + its feedback) and evaluator_suggestion; passed lines of the window become context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1"><mxGeometry x="600" y="1450" width="220" height="140" as="geometry"/></mxCell><mxCell id="n_fail" value="Only failed lines are retranslated, never whole windows" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fffbe6;strokeColor=#b3a14d;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="600" y="1620" width="220" height="55" as="geometry"/></mxCell><mxCell id="fin" value="&lt;b&gt;11. Finalize each line&lt;/b&gt;: keep the best attempt (passed &amp;gt; no rule failure &amp;gt; highest total score &amp;gt; earliest)&lt;br&gt;&lt;font style='font-size:9px'&gt;flags: retry_cap, line_too_long, glossary_mismatch, pronoun_mismatch, speaker_invalid, cps_exceeded, not_evaluated, speaker_override (changed a sure voice), low_speaker_conf (&amp;lt; 0.6)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1"><mxGeometry x="260" y="1700" width="320" height="130" as="geometry"/></mxCell><mxCell id="d12" value="12. More windows?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="320" y="1880" width="200" height="100" as="geometry"/></mxCell><mxCell id="write" value="&lt;b&gt;13.&lt;/b&gt; Write translations.jsonl + evaluations.jsonl + memory_prefix.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1"><mxGeometry x="260" y="2030" width="320" height="60" as="geometry"/></mxCell><mxCell id="rev" value="&lt;b&gt;14.&lt;/b&gt; Script review&lt;br&gt;(whole episode: repeats, noise, OCR fixes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="1" vertex="1"><mxGeometry x="280" y="2130" width="280" height="60" as="geometry"/></mxCell><mxCell id="gate" value="Review gate: human review in the app, or auto-approve" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1"><mxGeometry x="280" y="2230" width="280" height="60" as="geometry"/></mxCell><mxCell id="end" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="403" y="2330" width="34" height="34" as="geometry"/></mxCell><mxCell id="lg" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;fontSize=11;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1550" y="2200" width="320" height="210" as="geometry"/></mxCell><mxCell id="lgs0" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1565" y="2235" width="50" height="26" as="geometry"/></mxCell><mxCell id="lgt0" value="Code action (Python)" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1625" y="2235" width="230" height="26" as="geometry"/></mxCell><mxCell id="lgs1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1565" y="2269" width="50" height="26" as="geometry"/></mxCell><mxCell id="lgt1" value="LLM call" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1625" y="2269" width="230" height="26" as="geometry"/></mxCell><mxCell id="lgs2" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1565" y="2303" width="50" height="26" as="geometry"/></mxCell><mxCell id="lgt2" value="Decision" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1625" y="2303" width="230" height="26" as="geometry"/></mxCell><mxCell id="lgs3" value="" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.15;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1565" y="2337" width="50" height="26" as="geometry"/></mxCell><mxCell id="lgt3" value="Data / document" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1625" y="2337" width="230" height="26" as="geometry"/></mxCell><mxCell id="lgs4" value="" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fffbe6;strokeColor=#b3a14d;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="1565" y="2371" width="50" height="26" as="geometry"/></mxCell><mxCell id="lgt4" value="Note" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1625" y="2371" width="230" height="26" as="geometry"/></mxCell><mxCell id="a0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" parent="1" source="start" target="s1" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" parent="1" source="s1" target="s2" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" parent="1" source="s2" target="s3" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.46;" parent="1" source="s3" target="s4" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="s4" target="d5" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="770"/><mxPoint x="420" y="770"/></Array></mxGeometry></mxCell><mxCell id="a5" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="d5" target="d6" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a6" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="d5" target="miss" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a7" value="to step 9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="miss" target="judge" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="1260"/><mxPoint x="420" y="1260"/></Array></mxGeometry></mxCell><mxCell id="a8" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" parent="1" source="d6" target="reuse" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a9" value="to step 11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" parent="1" source="reuse" target="fin" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="1765"/></Array></mxGeometry></mxCell><mxCell id="a10" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;stroke