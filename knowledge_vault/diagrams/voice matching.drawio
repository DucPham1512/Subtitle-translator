<mxGraphModel dx="1263" dy="867" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="3260" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Voice matching: who is speaking, from the audio (voice/voice.py)" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="20" y="5" width="1760" height="40" as="geometry"/></mxCell><mxCell id="secM" value="Main flow: per episode, then per subtitle line" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#1f4e8c;" parent="1" vertex="1"><mxGeometry x="20" y="60" width="1400" height="2860" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;Why voice&lt;/b&gt;&lt;br&gt;The voices are AI-generated and steady per character, so the voice is the main speaker evidence. But the show reuses voices across minor characters, so two characters can sound alike: that is what the &lt;i&gt;confusable&lt;/i&gt; status and the confusable pairs are for. Subtitle events already cut the audio into lines, so no diarization model is used." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fffbe6;strokeColor=#b3a14d;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="1450" y="70" width="320" height="150" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Measured on the replay&lt;/b&gt; (16 episodes, 2,133 lines)&lt;br&gt;406 speaker errors; 266 of them NPC lines whose voice was confusable / unknown. On 263 lines the right NPC was not among the voice's candidates (188 in that NPC's first episode).&lt;br&gt;&lt;i&gt;đo lường - nhận diện nhân vật và giọng&lt;/i&gt;" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fffbe6;strokeColor=#b3a14d;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="1450" y="240" width="320" height="130" as="geometry"/></mxCell><mxCell id="lgb" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;fontSize=11;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1450" y="390" width="320" height="180" as="geometry"/></mxCell><mxCell id="lgs0" value="fixed / new voice" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1"><mxGeometry x="1470" y="422" width="130" height="28" as="geometry"/></mxCell><mxCell id="lgt0" value="speaker known (or a new voice)" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1610" y="422" width="150" height="28" as="geometry"/></mxCell><mxCell id="lgs1" value="confusable / unknown" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1"><mxGeometry x="1470" y="458" width="130" height="28" as="geometry"/></mxCell><mxCell id="lgt1" value="no single speaker: the translator decides" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1610" y="458" width="150" height="28" as="geometry"/></mxCell><mxCell id="lgs2" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1470" y="494" width="130" height="28" as="geometry"/></mxCell><mxCell id="lgt2" value="yellow diamond = decision" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1610" y="494" width="150" height="28" as="geometry"/></mxCell><mxCell id="lgs3" value="GPU" style="rounded=1;arcSize=30;html=1;fillColor=#76b900;strokeColor=#4d7a00;fontColor=#ffffff;fontSize=9;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1470" y="530" width="46" height="20" as="geometry"/></mxCell><mxCell id="lgt3" value="step runs on the GPU" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1610" y="530" width="150" height="28" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Values&lt;/b&gt; are series-1's (series.yaml overrides config.yaml, block &lt;i&gt;voice&lt;/i&gt; / &lt;i&gt;audio&lt;/i&gt;). Read the config before quoting them." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fffbe6;strokeColor=#b3a14d;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="1450" y="590" width="320" height="70" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;speakers.jsonl → the translator&lt;/b&gt; (translation.md 5.11): &lt;i&gt;fixed&lt;/i&gt; / &lt;i&gt;new_voice&lt;/i&gt;: kept unless the dialogue rules it out; &lt;i&gt;confusable&lt;/i&gt;: one of the listed candidates only; &lt;i&gt;unknown&lt;/i&gt; / &lt;i&gt;too_short&lt;/i&gt;: a speaker only when the dialogue makes it clear, otherwise none. &lt;b&gt;new_voices.json&lt;/b&gt; becomes the prompt's new-voices block." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fffbe6;strokeColor=#b3a14d;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="1450" y="2620" width="320" height="130" as="geometry"/></mxCell><mxCell id="i_vid" value="Source video" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.15;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" parent="1" vertex="1"><mxGeometry x="40" y="300" width="250" height="60" as="geometry"/></mxCell><mxCell id="i_bank" value="&lt;b&gt;Memory: voice bank&lt;/b&gt; (one ECAPA centroid per character) + confusable pairs" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.15;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" parent="1" vertex="1"><mxGeometry x="40" y="385" width="250" height="75" as="geometry"/></mxCell><mxCell id="i_ev" value="events.jsonl" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.15;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" parent="1" vertex="1"><mxGeometry x="40" y="710" width="250" height="60" as="geometry"/></mxCell><mxCell id="i_cand" value="&lt;b&gt;Memory: candidates on probation&lt;/b&gt; (new characters of the last 2 episodes, with their voice)" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.15;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" parent="1" vertex="1"><mxGeometry x="40" y="1990" width="200" height="90" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="685" y="95" width="30" height="30" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;1.&lt;/b&gt; Character identification on? (show.character_identification)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="590" y="155" width="220" height="110" as="geometry"/></mxCell><mxCell id="off" value="Stage off: no audio, voice or cast stages, no speakers (5.11a)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" parent="1" vertex="1"><mxGeometry x="960" y="185" width="240" height="50" as="geometry"/></mxCell><mxCell id="end1" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="1250" y="193" width="34" height="34" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;2.&lt;/b&gt; Audio stage (voice/audio.py): ffmpeg &lt;i&gt;-vn -ac 1 -ar 16000&lt;/i&gt; → audio.wav (mono, 16 kHz)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" parent="1" vertex="1"><mxGeometry x="520" y="300" width="360" height="55" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;3.&lt;/b&gt; Load the voice bank, leaving out archived and generic characters; load the confusable pairs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" parent="1" vertex="1"><mxGeometry x="520" y="390" width="360" height="55" as="geometry"/></mxCell><mxCell id="d4" value="&lt;b&gt;4.&lt;/b&gt; Voice bank empty?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="600" y="480" width="200" height="100" as="geometry"/></mxCell><mxCell id="p_empty" value="Every line &lt;i&gt;unknown&lt;/i&gt;: nothing to compare with, no new voices" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1"><mxGeometry x="960" y="505" width="250" height="50" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;5.&lt;/b&gt; Load SpeechBrain ECAPA once (speechbrain/spkrec-ecapa-voxceleb)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" parent="1" vertex="1"><mxGeometry x="520" y="620" width="360" height="55" as="geometry"/></mxCell><mxCell id="g5" value="GPU" style="rounded=1;arcSize=30;html=1;fillColor=#76b900;strokeColor=#4d7a00;fontColor=#ffffff;fontSize=9;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="840" y="612" width="46" height="20" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b&gt;6.&lt;/b&gt; LOOP: for each subtitle line" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=10;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="520" y="710" width="360" height="60" as="geometry"/></mxCell><mxCell id="d7" value="&lt;b&gt;7.&lt;/b&gt; Line shorter than 400 ms?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="600" y="810" width="200" height="100" as="geometry"/></mxCell><mxCell id="p_short" value="too_short" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1"><mxGeometry x="300" y="840" width="180" height="40" as="geometry"/></mxCell><mxCell id="d8" value="&lt;b&gt;8.&lt;/b&gt; Flagged &lt;i&gt;non_dialogue_suspect&lt;/i&gt; (sign, title, sound effect)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="575" y="945" width="250" height="120" as="geometry"/></mxCell><mxCell id="p_unk1" value="unknown" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1"><mxGeometry x="300" y="985" width="180" height="40" as="geometry"/></mxCell><mxCell id="s9" value="&lt;b&gt;9.&lt;/b&gt; Cut the line's audio: start − 100 ms to end + 100 ms (shorter than 400 ms after all → too_short)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" parent="1" vertex="1"><mxGeometry x="520" y="1100" width="360" height="65" as="geometry"/></mxCell><mxCell id="s10" value="&lt;b&gt;10.&lt;/b&gt; ECAPA embedding of the clip, L2-normalised; kept for the line (voice_embeddings.npz)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" parent="1" vertex="1"><mxGeometry x="520" y="1205" width="360" height="65" as="geometry"/></mxCell><mxCell id="g10" value="GPU" style="rounded=1;arcSize=30;html=1;fillColor=#76b900;strokeColor=#4d7a00;fontColor=#ffffff;fontSize=9;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="840" y="1197" width="46" height="20" as="geometry"/></mxCell><mxCell id="s11" value="&lt;b&gt;11.&lt;/b&gt; Cosine similarity with every centroid → top 3 candidates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" parent="1" vertex="1"><mxGeometry x="520" y="1310" width="360" height="55" as="geometry"/></mxCell><mxCell id="d12" value="&lt;b&gt;12.&lt;/b&gt; Top-1 &amp;lt; 0.35?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="600" y="1400" width="200" height="100" as="geometry"/></mxCell><mxCell id="p_unk2" value="unknown" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1"><mxGeometry x="300" y="1430" width="180" height="40" as="geometry"/></mxCell><mxCell id="d13" value="&lt;b&gt;13.&lt;/b&gt; Top-1 ≥ 0.60 AND ≥ 0.08 ahead of top-2 AND that pair is not confusable?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="530" y="1540" width="340" height="140" as="geometry"/></mxCell><mxCell id="p_fixed" value="fixed: speaker = top-1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1"><mxGeometry x="970" y="1590" width="220" height="40" as="geometry"/></mxCell><mxCell id="p_conf" value="confusable: top 3 candidates" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1"><mxGeometry x="280" y="1590" width="200" height="40" as="geometry"/></mxCell><mxCell id="m" value="More lines?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="620" y="1720" width="160" height="80" as="geometry"/></mxCell><mxCell id="secN" value="After the loop: new voices (voice.new_voices, only with a voice bank)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f6fbf4;strokeColor=#82b366;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#2d6a2d;" parent="1" vertex="1"><mxGeometry x="260" y="1840" width="1120" height="790" as="geometry"/></mxCell><mxCell id="s14" value="&lt;b&gt;14.&lt;/b&gt; Pool: &lt;i&gt;unknown&lt;/i&gt; and &lt;i&gt;confusable&lt;/i&gt; lines whose top-1 is &amp;lt; 0.70 (a new character mostly scores as a low confusable, not unknown)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" parent="1" vertex="1"><mxGeometry x="520" y="1885" width="360" height="65" as="geometry"/></mxCell><mxCell id="d15" value="&lt;b&gt;15.&lt;/b&gt; (per pooled line) Sounds like a candidate on probation: ≥ 0.60 AND ≥ 0.08 above its best known character?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="520" y="1990" width="360" height="150" as="geometry"/></mxCell><mxCell id="p_back1" value="Keeps the candidate's id: returning (status new_voice)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1"><mxGeometry x="970" y="2040" width="250" height="50" as="geometry"/></mxCell><mxCell id="s16" value="&lt;b&gt;16.&lt;/b&gt; Group the other lines by voice: merge the two groups with the most similar mean voice while ≥ 0.60, then drop members below it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" parent="1" vertex="1"><mxGeometry x="520" y="2180" width="360" height="65" as="geometry"/></mxCell><mxCell id="d17" value="&lt;b&gt;17.&lt;/b&gt; Group has ≥ 3 lines AND its mean voice is &amp;lt; 0.65 to every known character?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="530" y="2280" width="340" height="140" as="geometry"/></mxCell><mxCell id="p_stay" value="Lines stay unknown / confusable" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1"><mxGeometry x="280" y="2330" width="200" height="40" as="geometry"/></mxCell><mxCell id="d18" value="&lt;b&gt;18.&lt;/b&gt; Group's mean voice ≥ 0.60 to a candidate?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="590" y="2455" width="220" height="100" as="geometry"/></mxCell><mxCell id="p_back2" value="Its lines take the candidate's id: returning" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1"><mxGeometry x="970" y="2480" width="250" height="50" as="geometry"/></mxCell><mxCell id="p_new" value="New voice &lt;i&gt;npc_&amp;lt;ep&amp;gt;_&amp;lt;n&amp;gt;&lt;/i&gt;: its lines get status new_voice" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1"><mxGeometry x="545" y="2570" width="310" height="45" as="geometry"/></mxCell><mxCell id="s19" value="&lt;b&gt;19.&lt;/b&gt; Write voice_embeddings.npz, new_voices.json, then speakers.jsonl (the stage's output, written last)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" parent="1" vertex="1"><mxGeometry x="500" y="2680" width="400" height="65" as="geometry"/></mxCell><mxCell id="end" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="683" y="2800" width="34" height="34" as="geometry"/></mxCell><mxCell id="o_spk" value="&lt;b&gt;speakers.jsonl&lt;/b&gt; (per line: top 3 candidates with scores, status)" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.15;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fillColor=#e6e6e6;" parent="1" vertex="1"><mxGeometry x="40" y="2650" width="200" height="75" as="geometry"/></mxCell><mxCell id="o_new" value="&lt;b&gt;new_voices.json&lt;/b&gt; (new voices and returning candidates, their lines)" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.15;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fillColor=#e6e6e6;" parent="1" vertex="1"><mxGeometry x="40" y="2740" width="200" height="75" as="geometry"/></mxCell><mxCell id="o_emb" value="&lt;b&gt;voice_embeddings.npz&lt;/b&gt; (every matched line's voice; kept by cleanup)" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.15;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fillColor=#e6e6e6;" parent="1" vertex="1"><mxGeometry x="40" y="2830" width="200" height="75" as="geometry"/></mxCell><mxCell id="secL" value="Later: learning after the human review (voice/learning.py)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbf7ff;strokeColor=#9673a6;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#5a3d7a;" parent="1" vertex="1"><mxGeometry x="20" y="2960" width="1400" height="260" as="geometry"/></mxCell><mxCell id="l1" value="&lt;b&gt;Clips&lt;/b&gt;: approved dialogue lines ≥ 800 ms with a known speaker (80 ms trimmed at each end). Human-mode episodes: every such line." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" parent="1" vertex="1"><mxGeometry x="50" y="3030" width="240" height="150" as="geometry"/></mxCell><mxCell id="l2" value="&lt;b&gt;Auto-mode episodes&lt;/b&gt;: only lines every signal agrees on: fixed / new_voice, top-1 ≥ 0.70, margin ≥ 0.15, the translator kept that speaker, first evaluation passed, no flags but cps / pinyin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" parent="1" vertex="1"><mxGeometry x="320" y="3030" width="240" height="150" as="geometry"/></mxCell><mxCell id="l3" value="&lt;b&gt;Gate&lt;/b&gt; for the auto lines: leave-one-episode-out accuracy on human-reviewed lines, with and without them; used only with ≥ 30 test lines and no drop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" parent="1" vertex="1"><mxGeometry x="590" y="3030" width="240" height="150" as="geometry"/></mxCell><mxCell id="l4" value="&lt;b&gt;Centroid&lt;/b&gt; per character = bootstrap clips + lines (needs ≥ 3; with ≥ 10 the least typical 10% are dropped). &lt;b&gt;Confusable pairs&lt;/b&gt;: centroids ≥ 0.75 alike" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" parent="1" vertex="1"><mxGeometry x="860" y="3030" width="240" height="150" as="geometry"/></mxCell><mxCell id="l5" value="Memory commit &lt;i&gt;'voices learned from N lines'&lt;/i&gt; (through the Memory Manager)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1"><mxGeometry x="1130" y="3030" width="240" height="150" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Probation (5.15b)&lt;/b&gt;: at finish, a new voice with ≥ 3 approved lines becomes a candidate; its voice is the mean of its lines in voice_embeddings.npz. Heard again within 2 episodes, it can be promoted to a character." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fffbe6;strokeColor=#b3a14d;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="1450" y="2970" width="320" height="120" as="geometry"/></mxCell><mxCell id="a0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" parent="1" source="start" target="d1" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a1" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="d1" target="off" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a1b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="off" target="end1" edge="1"><mxGeometry relative="1" as="geom