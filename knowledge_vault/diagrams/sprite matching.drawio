<mxGraphModel dx="842" dy="731" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="2780" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Sprite matching: who is on screen and who is talking (stages/cast.py)" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="20" y="5" width="1760" height="40" as="geometry"/></mxCell><mxCell id="secM" value="Main flow: per subtitle line" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#1f4e8c;" parent="1" vertex="1"><mxGeometry x="20" y="60" width="1400" height="2390" as="geometry"/></mxCell><mxCell id="secL" value="Later: learning after the human review (memory/sprite_learning.py)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbf7ff;strokeColor=#9673a6;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#5a3d7a;" parent="1" vertex="1"><mxGeometry x="20" y="2490" width="1400" height="260" as="geometry"/></mxCell><mxCell id="n1" value="The picture is WEAK evidence for the speaker (often the speaker is off screen, or characters standing together move together)" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fffbe6;strokeColor=#b3a14d;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="1450" y="70" width="320" height="90" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Measured on the replay&lt;/b&gt;&lt;br&gt;boxes found 99%&lt;br&gt;named right 38.5%&lt;br&gt;talking sprite names the speaker 21.9%" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fffbe6;strokeColor=#b3a14d;fontSize=10;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="1450" y="180" width="320" height="90" as="geometry"/></mxCell><mxCell id="lgb" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;fontSize=11;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1450" y="290" width="320" height="215" as="geometry"/></mxCell><mxCell id="lgs0" value="Named" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1"><mxGeometry x="1470" y="322" width="130" height="28" as="geometry"/></mxCell><mxCell id="lgt0" value="green pill = character named" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1610" y="322" width="150" height="28" as="geometry"/></mxCell><mxCell id="lgs1" value="Unrecognised" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1"><mxGeometry x="1470" y="358" width="130" height="28" as="geometry"/></mxCell><mxCell id="lgt1" value="orange pill = not recognised" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1610" y="358" width="150" height="28" as="geometry"/></mxCell><mxCell id="lgs2" value="TALKING sprite" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;fillColor=#ffffff;strokeColor=#d00000;strokeWidth=3;fontColor=#b00000;" parent="1" vertex="1"><mxGeometry x="1470" y="394" width="130" height="28" as="geometry"/></mxCell><mxCell id="lgt2" value="red outline = talking" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1610" y="394" width="150" height="28" as="geometry"/></mxCell><mxCell id="lgs3" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1470" y="430" width="130" height="28" as="geometry"/></mxCell><mxCell id="lgt3" value="yellow diamond = decision" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1610" y="430" width="150" height="28" as="geometry"/></mxCell><mxCell id="lgs4" value="GPU" style="rounded=1;arcSize=30;html=1;fillColor=#76b900;strokeColor=#4d7a00;fontColor=#ffffff;fontSize=9;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1470" y="466" width="46" height="20" as="geometry"/></mxCell><mxCell id="lgt4" value="step runs on the GPU" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1610" y="466" width="150" height="28" as="geometry"/></mxCell><mxCell id="i_bank" value="&lt;b&gt;Memory: sprite bank&lt;/b&gt;&lt;br&gt;(pictures of each character as DINOv2 feature vectors)" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.15;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" parent="1" vertex="1"><mxGeometry x="40" y="290" width="250" height="85" as="geometry"/></mxCell><mxCell id="i_ev" value="&lt;b&gt;events.jsonl&lt;/b&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.15;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" parent="1" vertex="1"><mxGeometry x="40" y="410" width="250" height="60" as="geometry"/></mxCell><mxCell id="i_vid" value="&lt;b&gt;Source video&lt;/b&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.15;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" parent="1" vertex="1"><mxGeometry x="40" y="500" width="250" height="60" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="685" y="100" width="30" height="30" as="geometry"/></mxCell><mxCell id="d1" value="1. cast.enabled?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="600" y="165" width="200" height="100" as="geometry"/></mxCell><mxCell id="empty" value="Write empty cast.jsonl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" parent="1" vertex="1"><mxGeometry x="980" y="190" width="200" height="50" as="geometry"/></mxCell><mxCell id="end1" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="1250" y="198" width="34" height="34" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;2.&lt;/b&gt; Load the sprite bank, leaving out archived and generic characters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" parent="1" vertex="1"><mxGeometry x="520" y="305" width="360" height="55" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;3.&lt;/b&gt; Load models once: OWLv2 detector, DINOv2 image features" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" parent="1" vertex="1"><mxGeometry x="520" y="395" width="360" height="55" as="geometry"/></mxCell><mxCell id="g3" value="GPU" style="rounded=1;arcSize=30;html=1;fillColor=#76b900;strokeColor=#4d7a00;fontColor=#ffffff;fontSize=9;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="840" y="387" width="46" height="20" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;4.&lt;/b&gt; Decode each line's MIDDLE frame (960 px wide, picked on a 5 fps grid)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" parent="1" vertex="1"><mxGeometry x="520" y="485" width="360" height="60" as="geometry"/></mxCell><mxCell id="s5" value="5. LOOP: for each subtitle line" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=10;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="520" y="585" width="360" height="60" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b&gt;6.&lt;/b&gt; Save the analysed frame (cast_frames/&amp;lt;line&amp;gt;.jpg, used by the review screen)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" parent="1" vertex="1"><mxGeometry x="520" y="685" width="360" height="55" as="geometry"/></mxCell><mxCell id="s7" value="&lt;b&gt;7.&lt;/b&gt; OWLv2: find characters with the text queries 'a cartoon character', 'a cartoon person', 'a cartoon fish', 'a dog'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" parent="1" vertex="1"><mxGeometry x="520" y="775" width="360" height="70" as="geometry"/></mxCell><mxCell id="g7" value="GPU" style="rounded=1;arcSize=30;html=1;fillColor=#76b900;strokeColor=#4d7a00;fontColor=#ffffff;fontSize=9;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="840" y="767" width="46" height="20" as="geometry"/></mxCell><mxCell id="s8" value="&lt;b&gt;8.&lt;/b&gt; Filter boxes: score &amp;gt;= 0.15, height &amp;gt;= 12% of frame, width 5%-90% of frame" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" parent="1" vertex="1"><mxGeometry x="520" y="880" width="360" height="55" as="geometry"/></mxCell><mxCell id="s9" value="&lt;b&gt;9.&lt;/b&gt; Non-maximum suppression: drop a box overlapping a kept one (IoU &amp;gt;= 0.5) or 80% inside it (a head inside a body)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" parent="1" vertex="1"><mxGeometry x="520" y="970" width="360" height="70" as="geometry"/></mxCell><mxCell id="s10" value="&lt;b&gt;10.&lt;/b&gt; Crop each box → DINOv2 feature vector" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" parent="1" vertex="1"><mxGeometry x="520" y="1075" width="360" height="50" as="geometry"/></mxCell><mxCell id="g10" value="GPU" style="rounded=1;arcSize=30;html=1;fillColor=#76b900;strokeColor=#4d7a00;fontColor=#ffffff;fontSize=9;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="840" y="1067" width="46" height="20" as="geometry"/></mxCell><mxCell id="s11" value="&lt;b&gt;11.&lt;/b&gt; Compare with every character's closest picture in the bank" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" parent="1" vertex="1"><mxGeometry x="520" y="1160" width="360" height="50" as="geometry"/></mxCell><mxCell id="d12" value="12. (per box) Best &amp;gt;= 0.70 similar&lt;br&gt;AND &amp;gt;= 0.03 ahead of the next character?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="530" y="1245" width="340" height="120" as="geometry"/></mxCell><mxCell id="p_nam" value="Named: character id + similarity" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1"><mxGeometry x="970" y="1285" width="220" height="40" as="geometry"/></mxCell><mxCell id="p_unr" value="Unrecognised" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1"><mxGeometry x="300" y="1285" width="180" height="40" as="geometry"/></mxCell><mxCell id="d13" value="13. 2 or more characters on screen?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="590" y="1405" width="220" height="100" as="geometry"/></mxCell><mxCell id="notalk" value="No talking claim (a lone character may be listening to someone off screen)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;fillColor=#eeeeee;strokeColor=#999999;fontStyle=0;" parent="1" vertex="1"><mxGeometry x="970" y="1425" width="250" height="60" as="geometry"/></mxCell><mxCell id="s14" value="&lt;b&gt;14.&lt;/b&gt; Decode the whole line at 10 fps, 480 px wide (grey)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" parent="1" vertex="1"><mxGeometry x="520" y="1545" width="360" height="50" as="geometry"/></mxCell><mxCell id="s15" value="&lt;b&gt;15.&lt;/b&gt; For each pair of frames: track feature points, estimate the CAMERA motion (RANSAC partial affine), warp and subtract → remaining movement; ignore the subtitle band" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" parent="1" vertex="1"><mxGeometry x="500" y="1630" width="400" height="80" as="geometry"/></mxCell><mxCell id="s16" value="&lt;b&gt;16.&lt;/b&gt; Motion of each box = mean remaining movement in its UPPER HALF (the head / mouth)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" parent="1" vertex="1"><mxGeometry x="520" y="1745" width="360" height="55" as="geometry"/></mxCell><mxCell id="d17" value="17. Top mover &amp;gt;= 1.6 x the second?&lt;br&gt;(second counted at least 0.5)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="530" y="1835" width="340" height="130" as="geometry"/></mxCell><mxCell id="p_talk" value="That box is the TALKING sprite" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;fillColor=#ffffff;strokeColor=#d00000;strokeWidth=3;fontColor=#b00000;" parent="1" vertex="1"><mxGeometry x="970" y="1880" width="220" height="40" as="geometry"/></mxCell><mxCell id="p_none" value="Nobody clearly talking" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;fillColor=#eeeeee;strokeColor=#999999;fontStyle=0;" parent="1" vertex="1"><mxGeometry x="300" y="1880" width="180" height="40" as="geometry"/></mxCell><mxCell id="m" value="More lines?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1"><mxGeometry x="620" y="2010" width="160" height="80" as="geometry"/></mxCell><mxCell id="s19" value="&lt;b&gt;19.&lt;/b&gt; Group unrecognised crops of the episode into unknown sprites u001, u002... (similarity &amp;gt;= 0.75)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" parent="1" vertex="1"><mxGeometry x="500" y="2190" width="400" height="65" as="geometry"/></mxCell><mxCell id="end" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="683" y="2320" width="34" height="34" as="geometry"/></mxCell><mxCell id="o_cast" value="&lt;b&gt;cast.jsonl&lt;/b&gt;&lt;br&gt;(per line: boxes, names, unknown ids, motion, talking)" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.15;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fillColor=#e6e6e6;" parent="1" vertex="1"><mxGeometry x="40" y="2170" width="250" height="85" as="geometry"/></mxCell><mxCell id="o_emb" value="&lt;b&gt;cast_embeddings.npy&lt;/b&gt;&lt;br&gt;(features of every box)" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.15;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fillColor=#e6e6e6;" parent="1" vertex="1"><mxGeometry x="40" y="2290" width="250" height="70" as="geometry"/></mxCell><mxCell id="l1" value="Trusted speakers (every approved line in human mode; only lines all signals agree on in auto mode) + the reviewer's box edits from the On screen tab" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" parent="1" vertex="1"><mxGeometry x="50" y="2560" width="240" height="140" as="geometry"/></mxCell><mxCell id="l2" value="Talking sprite named as the speaker → exemplar +1 right; named someone else → +1 wrong; exemplars with more wrong than right are removed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" parent="1" vertex="1"><mxGeometry x="320" y="2560" width="240" height="140" as="geometry"/></mxCell><mxCell id="l3" value="Unknown sprite that talks on &amp;gt;= 3 lines, &amp;gt;= 75% for one speaker → becomes that character" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" parent="1" vertex="1"><mxGeometry x="590" y="2560" width="240" height="140" as="geometry"/></mxCell><mxCell id="l4" value="Recognitions &amp;gt;= 0.85 and confirmed talkers join the bank; keep the best 60 per character" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" parent="1" vertex="1"><mxGeometry x="860" y="2560" width="240" height="140" as="geometry"/></mxCell><mxCell id="l5" value="&lt;b&gt;Memory commit&lt;/b&gt;&lt;br&gt;'sprites from epXXX'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1"><mxGeometry x="1130" y="2560" width="240" height="140" as="geometry"/></mxCell><mxCell id="le0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="l1" target="l2" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="le1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="l2" target="l3" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="le2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="l3" target="l4" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="le3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="l4" target="l5" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;lab